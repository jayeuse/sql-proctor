# Copy this file to .env in the same directory, then replace every placeholder
# with a local development value. Never commit .env.
POSTGRES_DB=sql_proctor
POSTGRES_USER=sql_proctor
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5432

MARIADB_DATABASE=sql_exec
MARIADB_USER=sql_runner
MARIADB_PASSWORD=replace-with-a-local-mariadb-password
MARIADB_PROVISIONER_USER=sql_provisioner
MARIADB_PROVISIONER_PASSWORD=replace-with-a-local-mariadb-provisioner-password
MARIADB_ROOT_PASSWORD=replace-with-a-local-mariadb-root-password
MARIADB_PORT=3306
